-- Уведомление
function LiquidGlass:Notify(text, duration)
    local T = self.Theme
    duration = duration or 3

    local gui = CoreGui:FindFirstChild("LiquidGlassUI")
    if not gui then return end

    local notif = new("Frame", {
        Parent = gui,
        AnchorPoint = Vector2.new(0.5, 1),
        Position = UDim2.new(0.5, 0, 1, 60),
        Size = UDim2.fromOffset(280, 46),
        BackgroundColor3 = T.Background,
        BackgroundTransparency = 0.3,
        BorderSizePixel = 0,
        ZIndex = 50,
    })
    new("UICorner", { Parent = notif, CornerRadius = UDim.new(0, 12) })
    new("UIStroke", { Parent = notif, Color = T.Stroke, Thickness = 1, Transparency = 0.8 })

    new("Frame", {
        Parent = notif,
        Size = UDim2.new(0, 3, 1, -12),
        Position = UDim2.fromOffset(6, 6),
        BackgroundColor3 = T.Accent,
        BorderSizePixel = 0,
        ZIndex = 51,
    })
    new("UICorner", { Parent = notif:FindFirstChildWhichIsA("Frame"), CornerRadius = UDim.new(1, 0) })

    new("TextLabel", {
        Parent = notif,
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(18, 0),
        Size = UDim2.new(1, -24, 1, 0),
        Font = T.Font,
        Text = text,
        TextColor3 = T.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        ZIndex = 51,
    })

    tween(notif, 0.3, { Position = UDim2.new(0.5, 0, 1, -80) }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    task.delay(duration, function()
        tween(notif, 0.25, { Position = UDim2.new(0.5, 0, 1, 60), BackgroundTransparency = 1 })
        task.wait(0.3)
        notif:Destroy()
    end)

    return notif
end

-- Финал
return LiquidGlass
