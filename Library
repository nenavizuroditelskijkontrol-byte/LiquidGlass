--[[
    RetroIPad UI Library v1.2
    Плитки расставляются вручную по координатам (без UIGridLayout).
--]]

local RetroIPad = {}
RetroIPad.__index = RetroIPad

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")

RetroIPad.Theme = {
    BgTop       = Color3.fromRGB(50, 100, 175),
    BgBottom    = Color3.fromRGB(30, 65, 130),
    Tile        = Color3.fromRGB(45, 45, 55),
    TileHover   = Color3.fromRGB(70, 70, 90),
    TileClick   = Color3.fromRGB(30, 30, 40),
    Bar         = Color3.fromRGB(35, 70, 130),
    BarHover    = Color3.fromRGB(55, 100, 170),
    Header      = Color3.fromRGB(20, 40, 80),
    Text        = Color3.fromRGB(255, 255, 255),
    Border      = Color3.fromRGB(15, 15, 20),
    Font        = Enum.Font.SourceSansBold,
    TextSize    = 16,
}

local function new(class, props)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do
        inst[k] = v
    end
    return inst
end

--// ================= ОКНО =================
function RetroIPad:CreateWindow(config)
    config = config or {}
    local T = self.Theme

    for _, name in ipairs({"LiquidGlassUI","LiquidGlass","RetroBloxUI","RetroIPadUI","RayfieldUI"}) do
        local old = CoreGui:FindFirstChild(name)
        if old then old:Destroy() end
    end

    local gui = new("ScreenGui", {
        Name = "RetroIPadUI",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = true,
    })
    gui.Parent = CoreGui

    local root = new("Frame", {
        Parent = gui,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = config.Position or UDim2.fromScale(0.5, 0.5),
        Size = config.Size or UDim2.fromOffset(720, 480),
        BackgroundColor3 = T.BgTop,
        BorderSizePixel = 2,
        BorderColor3 = T.Border,
    })
    new("UIGradient", {
        Parent = root,
        Color = ColorSequence.new(T.BgTop, T.BgBottom),
        Rotation = 90,
    })

    -- Верхняя полоса
    local topBar = new("Frame", {
        Parent = root,
        Size = UDim2.new(1, 0, 0, 22),
        BackgroundColor3 = Color3.fromRGB(240, 240, 240),
        BorderSizePixel = 0,
    })
    new("TextLabel", {
        Parent = topBar, BackgroundTransparency = 1,
        Position = UDim2.fromOffset(8, 0), Size = UDim2.new(0.5, 0, 1, 0),
        Font = Enum.Font.SourceSansBold, Text = "iPad",
        TextColor3 = Color3.fromRGB(30, 30, 30), TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    new("TextLabel", {
        Parent = topBar, BackgroundTransparency = 1,
        Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, -8, 1, 0),
        Font = Enum.Font.SourceSansBold, Text = "7:58 PM      25%",
        TextColor3 = Color3.fromRGB(30, 30, 30), TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Right,
    })

    -- Профиль
    local profile = new("Frame", {
        Parent = root,
        Position = UDim2.fromOffset(0, 22),
        Size = UDim2.new(0, 220, 1, -50),
        BackgroundTransparency = 1,
    })
    local avatar = new("Frame", {
        Parent = profile,
        Position = UDim2.fromOffset(15, 15),
        Size = UDim2.fromOffset(70, 70),
        BackgroundColor3 = Color3.fromRGB(240, 240, 240),
        BorderSizePixel = 2, BorderColor3 = T.Border,
    })
    new("TextLabel", {
        Parent = avatar, BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Font = Enum.Font.SourceSansBold, Text = "R",
        TextColor3 = Color3.fromRGB(40, 40, 40), TextSize = 40,
    })
    new("TextLabel", {
        Parent = profile, BackgroundTransparency = 1,
        Position = UDim2.fromOffset(95, 20), Size = UDim2.new(1, -100, 0, 22),
        Font = T.Font, Text = config.Username or "GibsonGuita...",
        TextColor3 = T.Text, TextSize = 18,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    new("TextLabel", {
        Parent = profile, BackgroundTransparency = 1,
        Position = UDim2.fromOffset(95, 44), Size = UDim2.new(1, -100, 0, 18),
        Font = Enum.Font.SourceSans, Text = "17   ◆  128",
        TextColor3 = Color3.fromRGB(180, 220, 180), TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    -- Нижняя полоса
    local bottom = new("Frame", {
        Parent = root,
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 0, 1, 0),
        Size = UDim2.new(1, 0, 0, 28),
        BackgroundColor3 = Color3.fromRGB(25, 45, 90),
        BorderSizePixel = 0,
    })
    new("TextLabel", {
        Parent = bottom, BackgroundTransparency = 1,
        Position = UDim2.fromOffset(12, 0), Size = UDim2.fromOffset(120, 28),
        Font = T.Font, Text = "Logout",
        TextColor3 = T.Text, TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    -- Область плиток (без лэйаута, расставим вручную)
    local grid = new("Frame", {
        Parent = root,
        Position = UDim2.fromOffset(226, 30),
        Size = UDim2.new(1, -236, 1, -60),
        BackgroundTransparency = 1,
    })

    -- Кнопка закрытия
    local close = new("TextButton", {
        Parent = root,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -4, 0, 26),
        Size = UDim2.fromOffset(20, 20),
        BackgroundColor3 = Color3.fromRGB(200, 60, 60),
        BorderSizePixel = 1, BorderColor3 = T.Border,
        Text = "X", Font = Enum.Font.SourceSansBold,
        TextColor3 = Color3.fromRGB(255, 255, 255), TextSize = 12,
        AutoButtonColor = false, ZIndex = 20,
    })
    close.MouseButton1Click:Connect(function() gui:Destroy() end)

    -- Перетаскивание
    do
        local drag, start, pos0
        topBar.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then
                drag = true; start = i.Position; pos0 = root.Position
                i.Changed:Connect(function()
                    if i.UserInputState == Enum.UserInputState.End then drag = false end
                end)
            end
        end)
        UserInputService.InputChanged:Connect(function(i)
            if drag and (i.UserInputType == Enum.UserInputType.MouseMovement
            or i.UserInputType == Enum.UserInputType.Touch) then
                local d = i.Position - start
                root.Position = UDim2.new(
                    pos0.X.Scale, pos0.X.Offset + d.X,
                    pos0.Y.Scale, pos0.Y.Offset + d.Y
                )
            end
        end)
    end

    local Window = {
        Gui = gui,
        Root = root,
        Grid = grid,
        Tiles = {},
        Pages = {},
        _tileCount = 0,  -- счётчик для ручной раскладки
    }
    setmetatable(Window, { __index = RetroIPad })
    return Window
end

--// ================= ПЛИТКА (ручная раскладка 3 в ряд) =================
function RetroIPad:CreateTile(window, config)
    local T = self.Theme
    config = config or {}
    local label = config.Text or "Tile"
    local icon  = config.Icon or "🎮"

    -- Считаем позицию вручную: 3 колонки, 2 строки
    local cellW, cellH = 150, 140
    local padX, padY = 10, 10
    local col = (window._tileCount % 3)
    local row = math.floor(window._tileCount / 3)
    window._tileCount = window._tileCount + 1

    local tile = new("Frame", {
        Parent = window.Grid,
        Position = UDim2.fromOffset(
            col * (cellW + padX),
            row * (cellH + padY)
        ),
        Size = UDim2.fromOffset(cellW, cellH),
        BackgroundColor3 = T.Tile,
        BorderSizePixel = 2,
        BorderColor3 = T.Border,
    })

    local iconFrame = new("Frame", {
        Parent = tile,
        Position = UDim2.fromOffset(10, 10),
        Size = UDim2.new(1, -20, 1, -50),
        BackgroundColor3 = Color3.fromRGB(60, 60, 75),
        BorderSizePixel = 1, BorderColor3 = T.Border,
    })
    new("TextLabel", {
        Parent = iconFrame, BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Font = Enum.Font.SourceSansBold, Text = icon,
        TextColor3 = Color3.fromRGB(220, 220, 230), TextSize = 52,
    })

    local bar = new("TextButton", {
        Parent = tile,
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 0, 1, 0),
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = T.Bar,
        BorderSizePixel = 0,
        Text = label, Font = T.Font,
        TextColor3 = T.Text, TextSize = T.TextSize,
        AutoButtonColor = false,
    })
    bar.MouseEnter:Connect(function()
        bar.BackgroundColor3 = T.BarHover
        tile.BackgroundColor3 = T.TileHover
    end)
    bar.MouseLeave:Connect(function()
        bar.BackgroundColor3 = T.Bar
        tile.BackgroundColor3 = T.Tile
    end)

    -- Страница поверх сетки
    local page = new("Frame", {
        Parent = window.Root,
        Position = UDim2.fromOffset(226, 30),
        Size = UDim2.new(1, -236, 1, -60),
        BackgroundColor3 = Color3.fromRGB(40, 80, 145),
        BorderSizePixel = 2, BorderColor3 = T.Border,
        Visible = false, ZIndex = 10,
    })

    local pageTitle = new("Frame", {
        Parent = page,
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundColor3 = T.Header,
        BorderSizePixel = 0,
    })
    new("TextLabel", {
        Parent = pageTitle, BackgroundTransparency = 1,
        Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -100, 1, 0),
        Font = T.Font, Text = label,
        TextColor3 = T.Text, TextSize = 16,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    local back = new("TextButton", {
        Parent = pageTitle,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -6, 0, 4),
        Size = UDim2.fromOffset(70, 24),
        BackgroundColor3 = T.Bar,
        BorderSizePixel = 1, BorderColor3 = T.Border,
        Text = "← Back", Font = T.Font,
        TextColor3 = T.Text, TextSize = 13,
        AutoButtonColor = false,
    })
    back.MouseEnter:Connect(function() back.BackgroundColor3 = T.BarHover end)
    back.MouseLeave:Connect(function() back.BackgroundColor3 = T.Bar end)
    back.MouseButton1Click:Connect(function() page.Visible = false end)

    local pageContent = new("ScrollingFrame", {
        Parent = page,
        Position = UDim2.fromOffset(6, 38),
        Size = UDim2.new(1, -12, 1, -44),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 4,
        ScrollBarImageColor3 = Color3.fromRGB(150, 180, 230),
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
    })
    new("UIListLayout", { Parent = pageContent, Padding = UDim.new(0, 4) })
    new("UIPadding", { Parent = pageContent, PaddingRight = UDim.new(0, 6) })

    bar.MouseButton1Click:Connect(function()
        bar.BackgroundColor3 = T.TileClick
        task.wait(0.08)
        bar.BackgroundColor3 = T.Bar
        page.Visible = true
    end)

    local TileObj = {
        Frame = tile, Bar = bar,
        Page = page, PageContent = pageContent,
        Name = label,
    }
    window.Tiles[label] = TileObj
    window.Pages[label] = TileObj
    return TileObj
end

--// ================= ЭЛЕМЕНТЫ =================

function RetroIPad:CreateButton(tile, config)
    local T = self.Theme
    config = config or {}
    local btn = new("TextButton", {
        Parent = tile.PageContent,
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundColor3 = T.Tile,
        BorderSizePixel = 1, BorderColor3 = T.Border,
        Text = config.Text or "Button", Font = T.Font,
        TextColor3 = T.Text, TextSize = 14,
        AutoButtonColor = false,
    })
    btn.MouseEnter:Connect(function() btn.BackgroundColor3 = T.TileHover end)
    btn.MouseLeave:Connect(function() btn.BackgroundColor3 = T.Tile end)
    btn.MouseButton1Click:Connect(function()
        btn.BackgroundColor3 = T.Bar
        task.wait(0.1)
        btn.BackgroundColor3 = T.TileHover
        pcall(config.Callback or function() end)
    end)
    return btn
end

function RetroIPad:CreateToggle(tile, config)
    local T = self.Theme
    config = config or {}
    local state = config.Default or false

    local row = new("Frame", {
        Parent = tile.PageContent,
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundColor3 = T.Tile,
        BorderSizePixel = 1, BorderColor3 = T.Border,
    })
    new("TextLabel", {
        Parent = row, BackgroundTransparency = 1,
        Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -60, 1, 0),
        Font = T.Font, Text = config.Text or "Toggle",
        TextColor3 = T.Text, TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    local box = new("TextButton", {
        Parent = row,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -6, 0.5, 0),
        Size = UDim2.fromOffset(22, 22),
        BackgroundColor3 = Color3.fromRGB(230, 230, 230),
        BorderSizePixel = 2, BorderColor3 = T.Border,
        Text = state and "✓" or "",
        Font = Enum.Font.SourceSansBold,
        TextColor3 = Color3.fromRGB(0, 130, 0), TextSize = 18,
        AutoButtonColor = false,
    })
    box.MouseButton1Click:Connect(function()
        state = not state
        box.Text = state and "✓" or ""
        pcall(config.Callback or function() end, state)
    end)
    return { Get = function() return state end }
end

function RetroIPad:CreateSlider(tile, config)
    local T = self.Theme
    config = config or {}
    local min, max = config.Min or 0, config.Max or 100
    local value = math.clamp(config.Default or min, min, max)

    local row = new("Frame", {
        Parent = tile.PageContent,
        Size = UDim2.new(1, 0, 0, 48),
        BackgroundColor3 = T.Tile,
        BorderSizePixel = 1, BorderColor3 = T.Border,
    })
    new("TextLabel", {
        Parent = row, BackgroundTransparency = 1,
        Position = UDim2.fromOffset(10, 4), Size = UDim2.new(1, -60, 0, 16),
        Font = T.Font, Text = config.Text or "Slider",
        TextColor3 = T.Text, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    local valLabel = new("TextLabel", {
        Parent = row, BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -10, 4),
        Size = UDim2.fromOffset(50, 16),
        Font = T.Font, Text = tostring(value),
        TextColor3 = Color3.fromRGB(180, 220, 255), TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Right,
    })
    local bar = new("Frame", {
        Parent = row,
        Position = UDim2.fromOffset(10, 28),
        Size = UDim2.new(1, -20, 0, 10),
        BackgroundColor3 = Color3.fromRGB(25, 45, 90),
        BorderSizePixel = 2, BorderColor3 = T.Border,
    })
    local fill = new("Frame", {
        Parent = bar,
        Size = UDim2.fromScale((value - min) / (max - min), 1),
        BackgroundColor3 = T.Bar, BorderSizePixel = 0,
    })
    local drag = new("TextButton", {
        Parent = bar,
        Size = UDim2.fromScale(1, 2),
        Position = UDim2.fromScale(0, -0.5),
        BackgroundTransparency = 1, Text = "",
    })

    local dragging = false
    local function updateFromX(x)
        local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        value = math.floor(min + (max - min) * rel + 0.5)
        valLabel.Text = tostring(value)
        fill.Size = UDim2.fromScale(rel, 1)
        pcall(config.Callback or function() end, value)
    end
    drag.MouseButton1Down:Connect(function() dragging = true end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            updateFromX(i.Position.X)
        end
    end)
    drag.MouseButton1Click:Connect(function()
        updateFromX(UserInputService:GetMouseLocation().X)
    end)

    return {
        Set = function(v)
            value = math.clamp(v, min, max)
            valLabel.Text = tostring(value)
            fill.Size = UDim2.fromScale((value - min) / (max - min), 1)
            pcall(config.Callback or function() end, value)
        end,
        Get = function() return value end,
    }
end

function RetroIPad:CreateTextBox(tile, config)
    local T = self.Theme
    config = config or {}
    local row = new("Frame", {
        Parent = tile.PageContent,
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundColor3 = T.Tile,
        BorderSizePixel = 1, BorderColor3 = T.Border,
    })
    local box = new("TextBox", {
        Parent = row,
        BackgroundColor3 = Color3.fromRGB(230, 235, 245),
        BorderSizePixel = 2, BorderColor3 = T.Border,
        Position = UDim2.fromOffset(6, 4),
        Size = UDim2.new(1, -12, 1, -8),
        Font = T.Font, Text = "",
        PlaceholderText = config.Text or "Input",
        PlaceholderColor3 = Color3.fromRGB(120, 130, 150),
        TextColor3 = Color3.fromRGB(20, 20, 30), TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false,
    })
    box.FocusLost:Connect(function(enter)
        pcall(config.Callback or function() end, box.Text, enter)
    end)
    return { Set = function(v) box.Text = v end, Get = function() return box.Text end }
end

function RetroIPad:CreateSection(tile, text)
    local T = self.Theme
    return new("TextLabel", {
        Parent = tile.PageContent,
        Size = UDim2.new(1, 0, 0, 24),
        BackgroundColor3 = T.Header,
        BorderSizePixel = 1, BorderColor3 = T.Border,
        Font = T.Font, Text = text or "Section",
        TextColor3 = T.Text, TextSize = 13,
    })
end

function RetroIPad:Notify(text, duration)
    local T = self.Theme
    duration = duration or 3
    local gui = CoreGui:FindFirstChild("RetroIPadUI")
    if not gui then return end
    local notif = new("Frame", {
        Parent = gui,
        AnchorPoint = Vector2.new(0.5, 1),
        Position = UDim2.new(0.5, 0, 1, 60),
        Size = UDim2.fromOffset(320, 40),
        BackgroundColor3 = T.Bar,
        BorderSizePixel = 2, BorderColor3 = T.Border,
        ZIndex = 100,
    })
    new("TextLabel", {
        Parent = notif, BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Font = T.Font, Text = text,
        TextColor3 = T.Text, TextSize = 14, TextWrapped = true,
    })
    TweenService:Create(notif, TweenInfo.new(0.25), {
        Position = UDim2.new(0.5, 0, 1, -50)
    }):Play()
    task.delay(duration, function()
        TweenService:Create(notif, TweenInfo.new(0.25), {
            Position = UDim2.new(0.5, 0, 1, 60)
        }):Play()
        task.wait(0.3)
        notif:Destroy()
    end)
end

return RetroIPad
