local LiquidGlass = {}
LiquidGlass.__index = LiquidGlass

--// Сервисы
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer

--// Конфиг темы
LiquidGlass.Theme = {
    Background     = Color3.fromRGB(20, 20, 30),
    GlassTint      = Color3.fromRGB(255, 255, 255),
    GlassTransp    = 0.85,
    Blur           = 24,
    Accent         = Color3.fromRGB(120, 180, 255),
    AccentSoft     = Color3.fromRGB(80, 140, 220),
    Text           = Color3.fromRGB(240, 240, 250),
    SubText        = Color3.fromRGB(180, 180, 200),
    Stroke         = Color3.fromRGB(255, 255, 255),
    StrokeTransp   = 0.85,
    CornerRadius   = 14,
    Font           = Enum.Font.GothamMedium,
    TitleFont      = Enum.Font.GothamBold,
    AnimationTime  = 0.25,
}

--// Утилиты
local function new(class, props)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do
        inst[k] = v
    end
    return inst
end

local function tween(obj, time, props, style, dir)
    local info = TweenInfo.new(
        time or LiquidGlass.Theme.AnimationTime,
        style or Enum.EasingStyle.Quart,
        dir or Enum.EasingDirection.Out
    )
    local t = TweenService:Create(obj, info, props)
    t:Play()
    return t
end

--// Стеклянная панель
local function makeGlass(parent, size, position, radius)
    local T = LiquidGlass.Theme

    local container = new("Frame", {
        Parent = parent,
        Size = size,
        Position = position,
        BackgroundColor3 = T.Background,
        BackgroundTransparency = 0.35,
        BorderSizePixel = 0,
    })

    new("UICorner", {
        Parent = container,
        CornerRadius = UDim.new(0, radius or T.CornerRadius),
    })

    local blur = new("Frame", {
        Parent = container,
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = T.GlassTint,
        BackgroundTransparency = T.GlassTransp,
        BorderSizePixel = 0,
        ZIndex = container.ZIndex,
    })
    new("UICorner", { Parent = blur, CornerRadius = UDim.new(0, radius or T.CornerRadius) })

    local stroke = new("UIStroke", {
        Parent = container,
        Color = T.Stroke,
        Thickness = 1,
        Transparency = T.StrokeTransp,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    })

    new("UIGradient", {
        Parent = blur,
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.5),
            NumberSequenceKeypoint.new(0.5, 0.85),
            NumberSequenceKeypoint.new(1, 0.6),
        }),
        Rotation = 90,
    })

    return container, blur, stroke
end

--// ================= ОКНО =================
function LiquidGlass:CreateWindow(config)
    config = config or {}
    local T = self.Theme

    local title = config.Title or "LiquidGlass"
    local subtitle = config.Subtitle or "v1.0"
    local size = config.Size or UDim2.fromOffset(560, 380)
    local pos = config.Position or UDim2.fromScale(0.5, 0.5)
    local toggleKey = config.ToggleKey or Enum.KeyCode.RightShift

    local gui = new("ScreenGui", {
        Name = "LiquidGlassUI",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = true,
    })

    if CoreGui:FindFirstChild("LiquidGlassUI") then
        CoreGui.LiquidGlassUI:Destroy()
    end
    gui.Parent = CoreGui

    local root = new("Frame", {
        Parent = gui,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = pos,
        Size = size,
        BackgroundTransparency = 1,
    })

    local main, blurLayer, mainStroke = makeGlass(root, UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), T.CornerRadius)
    main.ZIndex = 2

    local header = new("Frame", {
        Parent = main,
        Size = UDim2.new(1, 0, 0, 48),
        BackgroundTransparency = 1,
        ZIndex = 3,
    })

    new("TextLabel", {
        Parent = header,
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(18, 8),
        Size = UDim2.new(1, -80, 0, 20),
        Font = T.TitleFont,
        Text = title,
        TextColor3 = T.Text,
        TextSize = 16,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 4,
    })

    new("TextLabel", {
        Parent = header,
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(18, 26),
        Size = UDim2.new(1, -80, 0, 14),
        Font = T.Font,
        Text = subtitle,
        TextColor3 = T.SubText,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 4,
    })

    local close = new("TextButton", {
        Parent = header,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -14, 0.5, 0),
        Size = UDim2.fromOffset(26, 26),
        BackgroundColor3 = T.Accent,
        BackgroundTransparency = 0.6,
        BorderSizePixel = 0,
        Text = "✕",
        Font = Enum.Font.GothamBold,
        TextColor3 = T.Text,
        TextSize = 14,
        AutoButtonColor = false,
        ZIndex = 5,
    })
    new("UICorner", { Parent = close, CornerRadius = UDim.new(1, 0) })

    close.MouseEnter:Connect(function()
        tween(close, 0.15, { BackgroundTransparency = 0.2 })
    end)
    close.MouseLeave:Connect(function()
        tween(close, 0.15, { BackgroundTransparency = 0.6 })
    end)
    close.MouseButton1Click:Connect(function()
        tween(root, 0.2, { Size = UDim2.fromOffset(0, 0) })
        task.wait(0.2)
        gui.Enabled = false
    end)

    local body = new("Frame", {
        Parent = main,
        Position = UDim2.fromOffset(0, 48),
        Size = UDim2.new(1, 0, 1, -48),
        BackgroundTransparency = 1,
        ZIndex = 3,
    })

    local sidebar = new("Frame", {
        Parent = body,
        Size = UDim2.new(0, 140, 1, -16),
        Position = UDim2.fromOffset(8, 8),
        BackgroundTransparency = 1,
        ZIndex = 4,
    })
    new("UIListLayout", {
        Parent = sidebar,
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
    })

    local content = new("Frame", {
        Parent = body,
        Position = UDim2.fromOffset(156, 8),
        Size = UDim2.new(1, -164, 1, -16),
        BackgroundTransparency = 1,
        ZIndex = 4,
    })

    -- Перетаскивание
    do
        local dragging, dragStart, startPos
        header.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = root.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - dragStart
                root.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end)
    end

    UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == toggleKey then
            gui.Enabled = not gui.Enabled
        end
    end)

    local Window = {
        Gui = gui,
        Root = root,
        Main = main,
        Sidebar = sidebar,
        Content = content,
        Tabs = {},
        ActiveTab = nil,
    }
    setmetatable(Window, { __index = LiquidGlass })

    root.Size = UDim2.fromOffset(0, 0)
    tween(root, 0.35, { Size = size }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

    return Window
end

--// ================= ВКЛАДКА =================
function LiquidGlass:CreateTab(window, name)
    local T = self.Theme
    name = name or "Tab"

    local btn = new("TextButton", {
        Parent = window.Sidebar,
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = T.Accent,
        BackgroundTransparency = 0.85,
        BorderSizePixel = 0,
        Text = "  " .. name,
        Font = T.Font,
        TextColor3 = T.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        AutoButtonColor = false,
        ZIndex = 5,
    })
    new("UICorner", { Parent = btn, CornerRadius = UDim.new(0, 10) })
    new("UIStroke", {
        Parent = btn,
        Color = T.Stroke,
        Thickness = 1,
        Transparency = 0.9,
    })

    local page = new("ScrollingFrame", {
        Parent = window.Content,
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = T.Accent,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
        ZIndex = 5,
    })
    new("UIListLayout", {
        Parent = page,
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
    })
    new("UIPadding", {
        Parent = page,
        PaddingRight = UDim.new(0, 8),
    })

    local tab = { Button = btn, Page = page, Name = name }

    btn.MouseEnter:Connect(function()
        if window.ActiveTab ~= tab then
            tween(btn, 0.15, { BackgroundTransparency = 0.7 })
        end
    end)
    btn.MouseLeave:Connect(function()
        if window.ActiveTab ~= tab then
            tween(btn, 0.15, { BackgroundTransparency = 0.85 })
        end
    end)
    btn.MouseButton1Click:Connect(function()
        if window.ActiveTab then
            window.ActiveTab.Page.Visible = false
            tween(window.ActiveTab.Button, 0.15, { BackgroundTransparency = 0.85 })
            window.ActiveTab.Button.TextColor3 = T.Text
        end
        window.ActiveTab = tab
        page.Visible = true
        tween(btn, 0.2, { BackgroundTransparency = 0.4 })
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    end)

    if not window.ActiveTab then
        window.ActiveTab = tab
        page.Visible = true
        btn.BackgroundTransparency = 0.4
    end

    window.Tabs[name] = tab
    return tab
end

