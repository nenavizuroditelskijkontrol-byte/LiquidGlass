local LiquidGlass = {}
LiquidGlass.__index = LiquidGlass

--// Сервисы
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer

--// Конфиг темы
LiquidGlass.Theme = {
    Background     = Color3.fromRGB(20, 20, 30),
    GlassTint      = Color3.fromRGB(255, 255, 255),
    GlassTransp    = 0.85,
    Accent         = Color3.fromRGB(120, 180, 255),
    AccentSoft     = Color3.fromRGB(80, 140, 220),
    Text           = Color3.fromRGB(240, 240, 250),
    SubText        = Color3.fromRGB(180, 180, 200),
    Stroke         = Color3.fromRGB(255, 255, 255),
    StrokeTransp   = 0.85,
    CornerRadius   = 14,
    Font           = Enum.Font.GothamMedium,
    TitleFont      = Enum.Font.GothamBold,
    AnimationTime  = 0.25,
}

--// Утилиты
local function new(class, props)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do
        inst[k] = v
    end
    return inst
end

local function tween(obj, time, props, style, dir)
    local info = TweenInfo.new(
        time or LiquidGlass.Theme.AnimationTime,
        style or Enum.EasingStyle.Quart,
        dir or Enum.EasingDirection.Out
    )
    local t = TweenService:Create(obj, info, props)
    t:Play()
    return t
end

--// Стеклянная панель
local function makeGlass(parent, size, position, radius)
    local T = LiquidGlass.Theme

    local container = new("Frame", {
        Parent = parent,
        Size = size,
        Position = position,
        BackgroundColor3 = T.Background,
        BackgroundTransparency = 0.35,
        BorderSizePixel = 0,
    })

    new("UICorner", {
        Parent = container,
        CornerRadius = UDim.new(0, radius or T.CornerRadius),
    })

    local blur = new("Frame", {
        Parent = container,
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = T.GlassTint,
        BackgroundTransparency = T.GlassTransp,
        BorderSizePixel = 0,
        ZIndex = container.ZIndex,
    })
    new("UICorner", { Parent = blur, CornerRadius = UDim.new(0, radius or T.CornerRadius) })

    local stroke = new("UIStroke", {
        Parent = container,
        Color = T.Stroke,
        Thickness = 1,
        Transparency = T.StrokeTransp,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    })

    new("UIGradient", {
        Parent = blur,
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.5),
            NumberSequenceKeypoint.new(0.5, 0.85),
            NumberSequenceKeypoint.new(1, 0.6),
        }),
        Rotation = 90,
    })

    return container, blur, stroke
end

--// ================= ПУЗЫРИ =================
local function createBubble(parent, config)
    config = config or {}
    local size = config.Size or math.random(50, 140)
    local startX = config.X or math.random(5, 95) / 100
    local duration = config.Duration or math.random(10, 18)
    local delay = config.Delay or math.random(0, 40) / 10

    local bubble = new("Frame", {
        Parent = parent,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(startX, 1.1),
        Size = UDim2.fromOffset(size * 0.6, size * 0.6),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BackgroundTransparency = 0.85,
        BorderSizePixel = 0,
        ZIndex = 1,
    })
    new("UICorner", { Parent = bubble, CornerRadius = UDim.new(1, 0) })

    new("UIGradient", {
        Parent = bubble,
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.00, Color3.fromRGB(180, 220, 255)),
            ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 200, 240)),
            ColorSequenceKeypoint.new(0.50, Color3.fromRGB(200, 255, 220)),
            ColorSequenceKeypoint.new(0.75, Color3.fromRGB(255, 240, 200)),
            ColorSequenceKeypoint.new(1.00, Color3.fromRGB(200, 220, 255)),
        }),
        Rotation = math.random(0, 360),
    })

    new("UIStroke", {
        Parent = bubble,
        Color = Color3.fromRGB(255, 255, 255),
        Thickness = 1.5,
        Transparency = 0.5,
    })

    local highlight = new("Frame", {
        Parent = bubble,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.3, 0.25),
        Size = UDim2.fromScale(0.3, 0.3),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BackgroundTransparency = 0.3,
        BorderSizePixel = 0,
        ZIndex = 2,
    })
    new("UICorner", { Parent = highlight, CornerRadius = UDim.new(1, 0) })
    new("UIGradient", {
        Parent = highlight,
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0),
            NumberSequenceKeypoint.new(1, 1),
        }),
        Rotation = 135,
    })

    local function animate()
        local targetX = startX + (math.random(-25, 25) / 100)
        local newSize = size * (0.8 + math.random() * 0.5)

        bubble.Position = UDim2.fromScale(startX, 1.1)
        bubble.Size = UDim2.fromOffset(size * 0.6, size * 0.6)
        bubble.BackgroundTransparency = 0.85

        local t = TweenService:Create(bubble, TweenInfo.new(
            duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut
        ), {
            Position = UDim2.fromScale(targetX, -0.2),
            Size = UDim2.fromOffset(newSize, newSize),
            BackgroundTransparency = 0.9,
        })
        t:Play()

        t.Completed:Connect(function()
            task.wait(delay)
            animate()
        end)
    end

    task.spawn(animate)
    return bubble
end

function LiquidGlass:CreateBubbleBackground(gui, count)
    count = count or 8
    local bg = new("Frame", {
        Parent = gui,
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Color3.fromRGB(15, 15, 25),
        BackgroundTransparency = 0.3,
        BorderSizePixel = 0,
        ZIndex = 0,
    })

    new("UIGradient", {
        Parent = bg,
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(30, 30, 50)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(15, 15, 25)),
        }),
        Rotation = 45,
    })

    for i = 1, count do
        createBubble(bg, {
            Size = math.random(50, 140),
            X = math.random(5, 95) / 100,
            Duration = math.random(10, 18),
            Delay = math.random(0, 40) / 10,
        })
    end

    return bg
end

