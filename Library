-- Кнопка с hover-эффектом (увеличение + наклон к курсору)
function LiquidGlass:CreateButton(tab, config)
    local T = self.Theme
    config = config or {}
    local text = config.Text or "Button"
    local callback = config.Callback or function() end

    -- Контейнер (держит размер, чтобы scale не влиял на layout)
    local wrapper = new("Frame", {
        Parent = tab.Page,
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundTransparency = 1,
    })

    -- Сама кнопка (внутри wrapper, чтобы scale шёл от центра)
    local btn = new("TextButton", {
        Parent = wrapper,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = T.Accent,
        BackgroundTransparency = 0.75,
        BorderSizePixel = 0,
        Text = text,
        Font = T.Font,
        TextColor3 = T.Text,
        TextSize = 13,
        AutoButtonColor = false,
    })
    new("UICorner", { Parent = btn, CornerRadius = UDim.new(0, 10) })
    new("UIStroke", { Parent = btn, Color = T.Stroke, Thickness = 1, Transparency = 0.85 })

    -- Состояние
    local hovered = false
    local scale = 1
    local rotation = Vector2.new(0, 0) -- X и Y наклон в градусах

    -- Hover логика
    btn.MouseEnter:Connect(function()
        hovered = true
        tween(btn, 0.2, { BackgroundTransparency = 0.5 }, Enum.EasingStyle.Quart)
    end)
    btn.MouseLeave:Connect(function()
        hovered = false
        -- Возвращаем всё назад
        tween(btn, 0.35, {
            BackgroundTransparency = 0.75,
            Rotation = 0,
        }, Enum.EasingStyle.Back)
        scale = 1
    end)

    -- Слежение за курсором для наклона и масштаба
    RunService.RenderStepped:Connect(function()
        if not btn.Parent or not wrapper.Parent then return end
        if not hovered then return end

        local mouse = UserInputService:GetMouseLocation()
        local absPos = btn.AbsolutePosition
        local absSize = btn.AbsoluteSize

        -- Нормализованные координаты относительно центра кнопки (-1..1)
        local relX = ((mouse.X - absPos.X) / absSize.X - 0.5) * 2
        local relY = ((mouse.Y - absPos.Y) / absSize.Y - 0.5) * 2

        relX = math.clamp(relX, -1, 1)
        relY = math.clamp(relY, -1, 1)

        -- Наклон: Y-курсор управляет X-наклоном, X-курсор — Y-наклоном
        local targetTiltX = -relY * 12   -- максимум 12 градусов
        local targetTiltY = relX * 12

        -- Плавно интерполируем
        rotation = Vector2.new(
            rotation.X + (targetTiltX - rotation.X) * 0.15,
            rotation.Y + (targetTiltY - rotation.Y) * 0.15
        )

        -- Масштаб: чем ближе к краю, тем сильнее увеличение (1.0 → 1.06)
        local dist = math.sqrt(relX * relX + relY * relY)
        local targetScale = 1 + math.clamp(dist, 0, 1) * 0.06
        scale = scale + (targetScale - scale) * 0.15

        -- Применяем
        btn.Rotation = rotation.Y
        -- Имитация 3D через Size + Position (Scale на UDim2)
        local s = scale
        btn.Size = UDim2.new(s, 0, s, 0)
        -- Компенсация смещения из-за scale — оставляем центр на месте через AnchorPoint
    end)

    btn.MouseButton1Click:Connect(function()
        tween(btn, 0.08, { BackgroundTransparency = 0.3 })
        task.wait(0.08)
        tween(btn, 0.15, { BackgroundTransparency = hovered and 0.5 or 0.75 })
        pcall(callback)
    end)

    return btn
end

-- Тоггл
function LiquidGlass:CreateToggle(tab, config)
    local T = self.Theme
    config = config or {}
    local text = config.Text or "Toggle"
    local default = config.Default or false
    local callback = config.Callback or function() end

    local state = default

    local row = new("Frame", {
        Parent = tab.Page,
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = T.GlassTint,
        BackgroundTransparency = 0.9,
        BorderSizePixel = 0,
    })
    new("UICorner", { Parent = row, CornerRadius = UDim.new(0, 10) })
    new("UIStroke", { Parent = row, Color = T.Stroke, Thickness = 1, Transparency = 0.9 })

    new("TextLabel", {
        Parent = row,
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(12, 0),
        Size = UDim2.new(1, -60, 1, 0),
        Font = T.Font,
        Text = text,
        TextColor3 = T.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    local track = new("Frame", {
        Parent = row,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.fromOffset(40, 20),
        BackgroundColor3 = state and T.Accent or Color3.fromRGB(80, 80, 95),
        BorderSizePixel = 0,
    })
    new("UICorner", { Parent = track, CornerRadius = UDim.new(1, 0) })

    local knob = new("Frame", {
        Parent = track,
        AnchorPoint = Vector2.new(0, 0.5),
        Position = state and UDim2.new(1, -20, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
        Size = UDim2.fromOffset(16, 16),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
    })
    new("UICorner", { Parent = knob, CornerRadius = UDim.new(1, 0) })

    local function apply(v)
        state = v
        tween(track, 0.2, {
            BackgroundColor3 = state and T.Accent or Color3.fromRGB(80, 80, 95)
        })
        tween(knob, 0.2, {
            Position = state and UDim2.new(1, -20, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
        })
        pcall(callback, state)
    end

    local click = new("TextButton", {
        Parent = row,
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "",
    })
    click.MouseButton1Click:Connect(function()
        apply(not state)
    end)

    return { Set = apply, Get = function() return state end }
end

-- Слайдер
function LiquidGlass:CreateSlider(tab, config)
    local T = self.Theme
    config = config or {}
    local text = config.Text or "Slider"
    local min = config.Min or 0
    local max = config.Max or 100
    local default = config.Default or min
    local callback = config.Callback or function() end

    local value = math.clamp(default, min, max)

    local row = new("Frame", {
        Parent = tab.Page,
        Size = UDim2.new(1, 0, 0, 52),
        BackgroundColor3 = T.GlassTint,
        BackgroundTransparency = 0.9,
        BorderSizePixel = 0,
    })
    new("UICorner", { Parent = row, CornerRadius = UDim.new(0, 10) })
    new("UIStroke", { Parent = row, Color = T.Stroke, Thickness = 1, Transparency = 0.9 })

    new("TextLabel", {
        Parent = row,
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(12, 6),
        Size = UDim2.new(1, -60, 0, 16),
        Font = T.Font,
        Text = text,
        TextColor3 = T.Text,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    local valueLabel = new("TextLabel", {
        Parent = row,
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -12, 6),
        Size = UDim2.fromOffset(50, 16),
        Font = T.Font,
        Text = tostring(value),
        TextColor3 = T.Accent,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right,
    })

    local bar = new("Frame", {
        Parent = row,
        Position = UDim2.fromOffset(12, 32),
        Size = UDim2.new(1, -24, 0, 8),
        BackgroundColor3 = Color3.fromRGB(60, 60, 75),
        BorderSizePixel = 0,
    })
    new("UICorner", { Parent = bar, CornerRadius = UDim.new(1, 0) })

    local fill = new("Frame", {
        Parent = bar,
        Size = UDim2.fromScale((value - min) / (max - min), 1),
        BackgroundColor3 = T.Accent,
        BorderSizePixel = 0,
    })
    new("UICorner", { Parent = fill, CornerRadius = UDim.new(1, 0) })
    new("UIGradient", {
        Parent = fill,
        Color = ColorSequence.new(T.AccentSoft, T.Accent),
    })

    local drag = new("TextButton", {
        Parent = bar,
        Size = UDim2.fromScale(1, 2),
        Position = UDim2.fromScale(0, -0.5),
        BackgroundTransparency = 1,
        Text = "",
    })

    local dragging = false

    local function updateFromX(x)
        local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        value = math.floor(min + (max - min) * rel + 0.5)
        valueLabel.Text = tostring(value)
        tween(fill, 0.05, { Size = UDim2.fromScale(rel, 1) })
        pcall(callback, value)
    end

    drag.MouseButton1Down:Connect(function() dragging = true end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateFromX(input.Position.X)
        end
    end)
    drag.MouseButton1Click:Connect(function()
        updateFromX(UserInputService:GetMouseLocation().X)
    end)

    return {
        Set = function(v)
            value = math.clamp(v, min, max)
            valueLabel.Text = tostring(value)
            fill.Size = UDim2.fromScale((value - min) / (max - min), 1)
            pcall(callback, value)
        end,
        Get = function() return value end,
    }
end

-- Текстбокс
function LiquidGlass:CreateTextBox(tab, config)
    local T = self.Theme
    config = config or {}
    local text = config.Text or "Input"
    local placeholder = config.Placeholder or "..."
    local callback = config.Callback or function() end

    local row = new("Frame", {
        Parent = tab.Page,
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = T.GlassTint,
        BackgroundTransparency = 0.9,
        BorderSizePixel = 0,
    })
    new("UICorner", { Parent = row, CornerRadius = UDim.new(0, 10) })
    new("UIStroke", { Parent = row, Color = T.Stroke, Thickness = 1, Transparency = 0.9 })

    local box = new("TextBox", {
        Parent = row,
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(12, 0),
        Size = UDim2.new(1, -24, 1, 0),
        Font = T.Font,
        Text = "",
        PlaceholderText = text .. " — " .. placeholder,
        PlaceholderColor3 = T.SubText,
        TextColor3 = T.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false,
    })

    box.Focused:Connect(function()
        tween(row, 0.15, { BackgroundTransparency = 0.75 })
    end)
    box.FocusLost:Connect(function(enter)
        tween(row, 0.15, { BackgroundTransparency = 0.9 })
        pcall(callback, box.Text, enter)
    end)

    return { Set = function(v) box.Text = v end, Get = function() return box.Text end }
end

