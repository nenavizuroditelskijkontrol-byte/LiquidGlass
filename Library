--[[
    RetroBlox UI Library v1.0
    Стиль: классический Roblox (2010-2013)
    - Серые панели, тёмно-синие кнопки, простые рамки
    - Никакого стекла, градиентов и анимаций "жидкого стекла"
--]]

local RetroBlox = {}
RetroBlox.__index = RetroBlox

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")

--// Классическая палитра старого Roblox
RetroBlox.Theme = {
    Panel       = Color3.fromRGB(160, 160, 160),  -- серый фон панели
    PanelDark   = Color3.fromRGB(120, 120, 120),  -- тёмно-серый для рамок
    Header      = Color3.fromRGB(100, 100, 100),  -- заголовок
    Button      = Color3.fromRGB(60, 90, 150),    -- тёмно-синие кнопки
    ButtonHover = Color3.fromRGB(80, 110, 180),
    ButtonClick = Color3.fromRGB(40, 70, 130),
    Text        = Color3.fromRGB(255, 255, 255),
    TextDark    = Color3.fromRGB(40, 40, 40),
    Border      = Color3.fromRGB(60, 60, 60),
    Font        = Enum.Font.SourceSansBold,
    TitleFont   = Enum.Font.SourceSansBold,
    TextSize    = 16,
}

local function new(class, props)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do
        inst[k] = v
    end
    return inst
end

--// Ретро-рамка (без закруглений, простой бордер)
local function retroFrame(parent, props)
    local f = new("Frame", props or {})
    f.BorderSizePixel = 2
    f.BorderColor3 = RetroBlox.Theme.Border
    return f
end

--// ================= ОКНО =================
function RetroBlox:CreateWindow(config)
    config = config or {}
    local T = self.Theme

    -- Чистим старые версии
    for _, name in ipairs({"LiquidGlassUI", "LiquidGlass", "RetroBloxUI", "RayfieldUI"}) do
        local old = CoreGui:FindFirstChild(name)
        if old then old:Destroy() end
    end

    local gui = new("ScreenGui", {
        Name = "RetroBloxUI",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = true,
    })
    gui.Parent = CoreGui

    -- Главная панель (серый прямоугольник с рамкой)
    local root = new("Frame", {
        Parent = gui,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = config.Position or UDim2.fromScale(0.5, 0.5),
        Size = config.Size or UDim2.fromOffset(560, 380),
        BackgroundColor3 = T.Panel,
        BorderSizePixel = 2,
        BorderColor3 = T.Border,
    })

    -- Заголовок (тёмно-серая полоса)
    local header = new("Frame", {
        Parent = root,
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = T.Header,
        BorderSizePixel = 0,
    })

    new("TextLabel", {
        Parent = header,
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(10, 0),
        Size = UDim2.new(1, -50, 1, 0),
        Font = T.TitleFont,
        Text = config.Title or "RetroBlox Menu",
        TextColor3 = T.Text,
        TextSize = T.TextSize,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    -- Кнопка закрытия в стиле старого Roblox (крестик в углу)
    local close = new("TextButton", {
        Parent = header,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        Size = UDim2.fromOffset(34, 34),
        BackgroundColor3 = T.Button,
        BorderSizePixel = 2,
        BorderColor3 = T.Border,
        Text = "X",
        Font = Enum.Font.SourceSansBold,
        TextColor3 = T.Text,
        TextSize = 18,
        AutoButtonColor = false,
    })
    close.MouseEnter:Connect(function()
        close.BackgroundColor3 = T.ButtonHover
    end)
    close.MouseLeave:Connect(function()
        close.BackgroundColor3 = T.Button
    end)
    close.MouseButton1Click:Connect(function()
        gui:Destroy()
    end)

    -- Тело
    local body = new("Frame", {
        Parent = root,
        Position = UDim2.fromOffset(0, 34),
        Size = UDim2.new(1, 0, 1, -34),
        BackgroundColor3 = T.Panel,
        BorderSizePixel = 0,
    })

    -- Сайдбар под вкладки
    local sidebar = new("Frame", {
        Parent = body,
        Size = UDim2.new(0, 130, 1, -12),
        Position = UDim2.fromOffset(6, 6),
        BackgroundColor3 = T.PanelDark,
        BorderSizePixel = 2,
        BorderColor3 = T.Border,
    })
    new("UIListLayout", {
        Parent = sidebar,
        Padding = UDim.new(0, 2),
        SortOrder = Enum.SortOrder.LayoutOrder,
    })
    new("UIPadding", { Parent = sidebar, PaddingTop = UDim.new(0, 4) })

    -- Контент
    local content = new("Frame", {
        Parent = body,
        Position = UDim2.fromOffset(144, 6),
        Size = UDim2.new(1, -150, 1, -12),
        BackgroundColor3 = T.PanelDark,
        BorderSizePixel = 2,
        BorderColor3 = T.Border,
    })

    -- Перетаскивание (за заголовок)
    do
        local drag, start, pos0
        header.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then
                drag = true
                start = i.Position
                pos0 = root.Position
                i.Changed:Connect(function()
                    if i.UserInputState == Enum.UserInputState.End then drag = false end
                end)
            end
        end)
        UserInputService.InputChanged:Connect(function(i)
            if drag and (i.UserInputType == Enum.UserInputType.MouseMovement
            or i.UserInputType == Enum.UserInputType.Touch) then
                local d = i.Position - start
                root.Position = UDim2.new(
                    pos0.X.Scale, pos0.X.Offset + d.X,
                    pos0.Y.Scale, pos0.Y.Offset + d.Y
                )
            end
        end)
    end

    local Window = {
        Gui = gui,
        Root = root,
        Sidebar = sidebar,
        Content = content,
        Tabs = {},
        ActiveTab = nil,
    }
    setmetatable(Window, { __index = RetroBlox })
    return Window
end

--// ================= ВКЛАДКА =================
function RetroBlox:CreateTab(window, name)
    local T = self.Theme
    name = name or "Tab"

    local btn = new("TextButton", {
        Parent = window.Sidebar,
        Size = UDim2.new(1, 0, 0, 28),
        BackgroundColor3 = T.Button,
        BorderSizePixel = 1,
        BorderColor3 = T.Border,
        Text = name,
        Font = T.Font,
        TextColor3 = T.Text,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Center,
        AutoButtonColor = false,
    })

    local page = new("ScrollingFrame", {
        Parent = window.Content,
        Size = UDim2.new(1, -8, 1, -8),
        Position = UDim2.fromOffset(4, 4),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 4,
        ScrollBarImageColor3 = Color3.fromRGB(100, 100, 100),
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
    })
    new("UIListLayout", { Parent = page, Padding = UDim.new(0, 4) })

    local tab = { Button = btn, Page = page, Name = name }

    btn.MouseEnter:Connect(function()
        if window.ActiveTab ~= tab then
            btn.BackgroundColor3 = T.ButtonHover
        end
    end)
    btn.MouseLeave:Connect(function()
        if window.ActiveTab ~= tab then
            btn.BackgroundColor3 = T.Button
        end
    end)
    btn.MouseButton1Click:Connect(function()
        if window.ActiveTab then
            window.ActiveTab.Page.Visible = false
            window.ActiveTab.Button.BackgroundColor3 = T.Button
        end
        window.ActiveTab = tab
        page.Visible = true
        btn.BackgroundColor3 = T.ButtonClick
    end)

    if not window.ActiveTab then
        window.ActiveTab = tab
        page.Visible = true
        btn.BackgroundColor3 = T.ButtonClick
    end

    window.Tabs[name] = tab
    return tab
end

--// ================= ЭЛЕМЕНТЫ =================

function RetroBlox:CreateButton(tab, config)
    local T = self.Theme
    config = config or {}

    local btn = new("TextButton", {
        Parent = tab.Page,
        Size = UDim2.new(1, 0, 0, 30),
        BackgroundColor3 = T.Button,
        BorderSizePixel = 1,
        BorderColor3 = T.Border,
        Text = config.Text or "Button",
        Font = T.Font,
        TextColor3 = T.Text,
        TextSize = 14,
        AutoButtonColor = false,
    })

    btn.MouseEnter:Connect(function()
        btn.BackgroundColor3 = T.ButtonHover
    end)
    btn.MouseLeave:Connect(function()
        btn.BackgroundColor3 = T.Button
    end)
    btn.MouseButton1Click:Connect(function()
        btn.BackgroundColor3 = T.ButtonClick
        task.wait(0.1)
        btn.BackgroundColor3 = T.ButtonHover
        pcall(config.Callback or function() end)
    end)

    return btn
end

function RetroBlox:CreateToggle(tab, config)
    local T = self.Theme
    config = config or {}
    local state = config.Default or false

    local row = new("Frame", {
        Parent = tab.Page,
        Size = UDim2.new(1, 0, 0, 30),
        BackgroundColor3 = T.Panel,
        BorderSizePixel = 1,
        BorderColor3 = T.Border,
    })

    new("TextLabel", {
        Parent = row,
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(8, 0),
        Size = UDim2.new(1, -50, 1, 0),
        Font = T.Font,
        Text = config.Text or "Toggle",
        TextColor3 = T.TextDark,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    -- Старый чекбокс (квадратная кнопка)
    local box = new("TextButton", {
        Parent = row,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -6, 0.5, 0),
        Size = UDim2.fromOffset(20, 20),
        BackgroundColor3 = Color3.fromRGB(220, 220, 220),
        BorderSizePixel = 2,
        BorderColor3 = T.Border,
        Text = state and "✓" or "",
        Font = Enum.Font.SourceSansBold,
        TextColor3 = Color3.fromRGB(0, 120, 0),
        TextSize = 16,
        AutoButtonColor = false,
    })

    box.MouseButton1Click:Connect(function()
        state = not state
        box.Text = state and "✓" or ""
        pcall(config.Callback or function() end, state)
    end)

    return { Get = function() return state end }
end

function RetroBlox:CreateSlider(tab, config)
    local T = self.Theme
    config = config or {}
    local min, max = config.Min or 0, config.Max or 100
    local value = math.clamp(config.Default or min, min, max)

    local row = new("Frame", {
        Parent = tab.Page,
        Size = UDim2.new(1, 0, 0, 46),
        BackgroundColor3 = T.Panel,
        BorderSizePixel = 1,
        BorderColor3 = T.Border,
    })

    new("TextLabel", {
        Parent = row,
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(8, 4),
        Size = UDim2.new(1, -60, 0, 16),
        Font = T.Font,
        Text = config.Text or "Slider",
        TextColor3 = T.TextDark,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    local valLabel = new("TextLabel", {
        Parent = row,
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -8, 4),
        Size = UDim2.fromOffset(50, 16),
        Font = T.Font,
        Text = tostring(value),
        TextColor3 = Color3.fromRGB(0, 80, 160),
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Right,
    })

    local bar = new("Frame", {
        Parent = row,
        Position = UDim2.fromOffset(8, 28),
        Size = UDim2.new(1, -16, 0, 10),
        BackgroundColor3 = Color3.fromRGB(100, 100, 100),
        BorderSizePixel = 2,
        BorderColor3 = T.Border,
    })

    local fill = new("Frame", {
        Parent = bar,
        Size = UDim2.fromScale((value - min) / (max - min), 1),
        BackgroundColor3 = T.Button,
        BorderSizePixel = 0,
    })

    local drag = new("TextButton", {
        Parent = bar,
        Size = UDim2.fromScale(1, 2),
        Position = UDim2.fromScale(0, -0.5),
        BackgroundTransparency = 1,
        Text = "",
    })

    local dragging = false
    local function updateFromX(x)
        local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        value = math.floor(min + (max - min) * rel + 0.5)
        valLabel.Text = tostring(value)
        fill.Size = UDim2.fromScale(rel, 1)
        pcall(config.Callback or function() end, value)
    end

    drag.MouseButton1Down:Connect(function() dragging = true end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            updateFromX(i.Position.X)
        end
    end)
    drag.MouseButton1Click:Connect(function()
        updateFromX(UserInputService:GetMouseLocation().X)
    end)

    return {
        Set = function(v)
            value = math.clamp(v, min, max)
            valLabel.Text = tostring(value)
            fill.Size = UDim2.fromScale((value - min) / (max - min), 1)
            pcall(config.Callback or function() end, value)
        end,
        Get = function() return value end,
    }
end

function RetroBlox:CreateTextBox(tab, config)
    local T = self.Theme
    config = config or {}

    local row = new("Frame", {
        Parent = tab.Page,
        Size = UDim2.new(1, 0, 0, 30),
        BackgroundColor3 = T.Panel,
        BorderSizePixel = 1,
        BorderColor3 = T.Border,
    })

    local box = new("TextBox", {
        Parent = row,
        BackgroundColor3 = Color3.fromRGB(230, 230, 230),
        BorderSizePixel = 2,
        BorderColor3 = T.Border,
        Position = UDim2.fromOffset(6, 4),
        Size = UDim2.new(1, -12, 1, -8),
        Font = T.Font,
        Text = "",
        PlaceholderText = config.Text or "Input",
        PlaceholderColor3 = Color3.fromRGB(120, 120, 120),
        TextColor3 = Color3.fromRGB(20, 20, 20),
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false,
    })

    box.FocusLost:Connect(function(enter)
        pcall(config.Callback or function() end, box.Text, enter)
    end)

    return { Set = function(v) box.Text = v end, Get = function() return box.Text end }
end

function RetroBlox:CreateSection(tab, text)
    local T = self.Theme
    return new("TextLabel", {
        Parent = tab.Page,
        Size = UDim2.new(1, 0, 0, 22),
        BackgroundColor3 = T.Header,
        BorderSizePixel = 1,
        BorderColor3 = T.Border,
        Font = T.TitleFont,
        Text = text or "Section",
        TextColor3 = T.Text,
        TextSize = 13,
    })
end

function RetroBlox:CreateDivider(tab)
    return new("Frame", {
        Parent = tab.Page,
        Size = UDim2.new(1, 0, 0, 2),
        BackgroundColor3 = Color3.fromRGB(80, 80, 80),
        BorderSizePixel = 0,
    })
end

--// Уведомление в стиле старого Roblox
function RetroBlox:Notify(text, duration)
    local T = self.Theme
    duration = duration or 3

    local gui = CoreGui:FindFirstChild("RetroBloxUI")
    if not gui then return end

    local notif = new("Frame", {
        Parent = gui,
        AnchorPoint = Vector2.new(0.5, 1),
        Position = UDim2.new(0.5, 0, 1, 60),
        Size = UDim2.fromOffset(300, 40),
        BackgroundColor3 = T.Panel,
        BorderSizePixel = 2,
        BorderColor3 = T.Border,
    })

    new("TextLabel", {
        Parent = notif,
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Font = T.Font,
        Text = text,
        TextColor3 = T.TextDark,
        TextSize = 14,
        TextWrapped = true,
    })

    local t1 = TweenService:Create(notif, TweenInfo.new(0.25), {
        Position = UDim2.new(0.5, 0, 1, -60)
    })
    t1:Play()

    task.delay(duration, function()
        local t2 = TweenService:Create(notif, TweenInfo.new(0.25), {
            Position = UDim2.new(0.5, 0, 1, 60)
        })
        t2:Play()
        task.wait(0.3)
        notif:Destroy()
    end)

    return notif
end

return RetroBlox
